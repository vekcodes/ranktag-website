# =====================================================================
# Local dev only — production uses Vercel dashboard env vars.
# Copy this file to .env.local and fill in real values.
# =====================================================================

# Optional: external density backend (leave empty to use same-origin /api/*).
VITE_DENSITY_API_URL=

# ── Blog / CMS ───────────────────────────────────────────────────────
# DATABASE_URL + BLOB_READ_WRITE_TOKEN are injected automatically when you
# create the Neon Postgres DB and Blob store in the Vercel dashboard and
# "Connect to Project". Run `vercel env pull .env.local` to fetch them here.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# CMS admin login (set these yourself in Vercel → Settings → Env Vars).
# BLOG_ADMIN_PASSWORD: the password for /admin
# BLOG_AUTH_SECRET: long random string for signing the session cookie
#   generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BLOG_ADMIN_PASSWORD=
BLOG_AUTH_SECRET=

# Optional: canonical site origin used in SEO tags/sitemap (no trailing slash).
# Defaults to https://rankedtag.com when unset.
SITE_URL=

# ── HubSpot ──────────────────────────────────────────────────────────
# Get the portal ID from HubSpot → Settings → Account Defaults → "Hub ID"
# (or look at the URL of any logged-in HubSpot page: app.hubspot.com/.../<PORTAL_ID>/...).
VITE_HUBSPOT_PORTAL_ID=

# Apply form ID — created in HubSpot → Marketing → Forms → Create form.
# After creating the form, open it and copy the form GUID from the URL or
# the embed code (looks like: a1b2c3d4-e5f6-7890-abcd-ef1234567890).
VITE_HUBSPOT_APPLY_FORM_ID=

# Region — HubSpot routes portals to regional data centers. Read it from
# the form embed's data-region attribute or the script URL host:
#   https://js.hsforms.net/...        → leave empty (na1, default)
#   https://js-na2.hsforms.net/...    → VITE_HUBSPOT_REGION=na2
#   https://js-eu1.hsforms.net/...    → VITE_HUBSPOT_REGION=eu1
VITE_HUBSPOT_REGION=

# ── Per-tool HubSpot forms ──────────────────────────────────────────
# Optional email capture on each tool page. Create one HubSpot form
# per tool with fields:  email (required), website, message.
# Leave these blank to disable email capture on a given tool — the
# tool still runs normally without it.
VITE_HUBSPOT_AUTHORITY_FORM_ID=
VITE_HUBSPOT_PAGESPEED_FORM_ID=
VITE_HUBSPOT_DENSITY_FORM_ID=
VITE_HUBSPOT_COMPETITOR_FORM_ID=

# Entry popup — the 15-minute strategy call. Same three fields as the
# per-tool forms (email required, website, message). Leave this blank and
# the popup falls back to VITE_HUBSPOT_APPLY_FORM_ID, so it still books
# leads; set it when you want call requests reported separately from
# full applications.
VITE_HUBSPOT_STRATEGY_FORM_ID=

# When creating the "Apply" form in HubSpot, add these fields with EXACTLY
# these internal names (the labels can be whatever you want):
#
#   firstname        — Single-line text (default)
#   lastname         — Single-line text (default)
#   email            — Email (default)
#   website          — Single-line text (default)
#   hs_linkedin_url  — Single-line text (HubSpot built-in; some portals have
#                      a custom `linkedin_url` instead — adjust hubspot.js)
#   message          — Multi-line text (default)
#
# Field internal names are case-sensitive. The code at src/lib/hubspot.js
# splits the user-typed "Your name" into firstname + lastname before sending.

# ── Google Search Console ────────────────────────────────────────────
# Reporting only (read-only scope). Powers /admin -> "Search", the CLI at
# scripts/gsc.mjs, and machine callers such as n8n.
#
# Setup:
#   1. Google Cloud Console -> APIs & Services -> Library -> enable
#      "Google Search Console API".
#   2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key ->
#      JSON. Keep that file OUT of this repo.
#   3. Search Console -> Settings -> Users and permissions -> Add user ->
#      paste the key's `client_email` -> permission "Full".
#
# Paste the key as base64, because the raw JSON contains newlines inside
# `private_key` that several dashboards mangle:
#   base64 -i service-account.json | tr -d '\n' | pbcopy
# (raw JSON is also accepted if you prefer)
GSC_SERVICE_ACCOUNT_JSON=

# Alternative to the above: the two fields on their own. Use one form or the
# other, not both. Keep the \n escapes in the private key as-is.
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=

# Which property to report on. A DNS-verified Domain property is addressed as
# `sc-domain:rankedtag.com`; a URL-prefix property as `https://rankedtag.com/`
# WITH the trailing slash. The wrong form is the usual cause of an empty
# report, so run `node scripts/gsc.mjs sites` to see the exact strings the
# service account can read. Defaults to sc-domain:rankedtag.com.
GSC_SITE_URL=

# Optional. Set this to let non-browser callers (n8n, scripts, the SEO engine)
# read the same data with `Authorization: Bearer <token>` instead of an admin
# session cookie. Leave blank and token auth stays disabled entirely.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GSC_API_TOKEN=
